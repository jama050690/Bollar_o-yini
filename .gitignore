# ============================================================
# "Aqlli Do'stlar" — Flutter loyihasi uchun .gitignore
# ============================================================

# ---------- Umumiy / OS ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# ---------- Loglar ----------
*.log
logs/

# ---------- IDE: IntelliJ / Android Studio ----------
*.iml
*.ipr
*.iws
.idea/

# ---------- IDE: VS Code ----------
# Loyiha sozlamalarini saqlash kerak bo'lsa, quyidagi qatorlarni o'zgartiring
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json

# ---------- Flutter / Dart ----------
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
build/
*.g.dart.bak

# Kod generatsiyasi (hive_generator, build_runner) — .g.dart fayllar SAQLANADI,
# chunki ular kompilyatsiya uchun kerak. Faqat keshlar e'tiborsiz qoldiriladi.
.build_runner/

# ---------- Symbolication / Obfuscation ----------
app.*.symbols
app.*.map.json

# ---------- Test / Coverage ----------
coverage/
*.lcov
test/.test_coverage.dart

# ---------- Android ----------
/android/app/debug
/android/app/profile
/android/app/release
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/app/.cxx/
**/android/.kotlin/
*.apk
*.aab
*.ap_
*.dex

# Android imzolash kalitlari — HECH QACHON gitga qo'shilmasin!
**/android/key.properties
*.jks
*.keystore
!debug.keystore

# ---------- iOS / Xcode ----------
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/*sync/
**/ios/**/.sconsign.dblite
**/ios/**/.tags*
**/ios/**/.vagrant/
**/ios/**/DerivedData/
**/ios/**/Icon?
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/**/profile
**/ios/**/xcuserdata
**/ios/.generated/
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
*.ipa
*.dSYM.zip
*.dSYM

# iOS imzolash fayllari — HECH QACHON gitga qo'shilmasin!
*.mobileprovision
*.p12
*.cer

# Istisnolar (Xcode shablonlari saqlanadi)
!**/ios/**/default.mode1v3
!**/ios/**/default.mode2v3
!**/ios/**/default.pbxuser
!**/ios/**/default.perspectivev3

# ---------- Maxfiy ma'lumotlar ----------
.env
.env.*
!.env.example
*.pem
secrets/

# ---------- Hive lokal baza fayllari (test paytida yaratilishi mumkin) ----------
*.hive
*.lock
!pubspec.lock
!**/ios/Podfile.lock
